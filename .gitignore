# Build directories (anywhere in repo)
**/build/

# Zephyr/CMake build artifacts
**/zephyr/
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/Makefile
**/*.ninja
**/compile_commands.json

# Compiled binaries
*.o
*.elf
*.bin
*.hex
*.map
*.a
*.lib

# IDE/Editor files
.vscode/
.idea/
*.swp
*.swo
*.user

# OS files
.DS_Store
Thumbs.db

# Python cache
__pycache__/
*.pyc
*.pyo

# Logs and temp files
*.log
*.tmp
*.bak

# Archives (optional - remove if you want to track these)
*.zip

# ChirpStack API token (v1.1 onboarding)
**/onboarding/api_key

# AWS automation generated configs
aws-iot-core-lorawan/automation/batchregistration/lorawan_configs/
