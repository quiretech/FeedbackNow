    {
      "id": "c-SgoglMUeDlDUQq3Ze4T",
      "type": "text",
      "x": 2077.511904761905,
      "y": 149.16666666666652,
      "width": 554.2857142857147,
      "height": 650,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
