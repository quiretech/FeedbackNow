      "seed": 953535350,
      "version": 319,
      "versionNonce": 664295798,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1781661236775,
      "link": null,
      "locked": false,
      "text": "enum rails {\n    rail_3v3;\n    rail_3v3a;\n    rail_3v6;\n    rail_1v8;\n};\n\n\nstruct rail {\n\n    atomic_t refcount;\n    bool enabled;\n    void (*hw_enable)(void);\n    void (*hw_disable)(void);\n};\n\n\n\n\n\n\n\n\n\n\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
