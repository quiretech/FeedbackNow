flowchart TD
    %% BOOT SEQUENCE (subsequent boot; first boot uses deliberate join 0+1+2 in staff)
    subgraph BOOT
        B1[Attempt join: 10 tries with exponential backoff]
        B2{Success?}
        B3[Normal operation - connected]
        B4[Disconnected mode: counters in EEPROM, retry every 1hr]

        B1 --> B2
        B2 -->|Yes| B3
        B2 -->|No| B4
    end

    %% HOURLY REJOIN
    subgraph HOURLY_REJOIN
        H1[Attempt join: 3 tries with backoff]
        H2{Success?}
        H3[Counter sync Event 0x07 per button, resume connected]
        H4[Continue disconnected, retry in 1hr]

        H1 --> H2
        H2 -->|Yes| H3
        H2 -->|No| H4
    end

    %% ON RECONNECT
    subgraph ON_RECONNECT
        R1[Counter sync: per-button Event 0x07 with latest counts, rate limited]
        R2[Sync RTC via DeviceTimeReq]
        R3[Resume normal heartbeat schedule]

        R1 --> R2 --> R3
    end

    %% FLOW
    B4 --> H1
    H3 --> R1
