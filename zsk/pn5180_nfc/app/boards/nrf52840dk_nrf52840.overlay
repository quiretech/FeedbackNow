
&arduino_spi {
	status = "okay";
	pn5180: pn5180@0 {
 		compatible = "nxp,pn5180";
		reg = <0>;
		spi-max-frequency = <7000000>;
		irq-gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
		rst-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		busy-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
		nss-gpios = <&gpio0 28 GPIO_ACTIVE_LOW>;
		timeout-ms = <1000>;
	};
};

/* Wake-up GPIO configuration */
/ {
	aliases {
		wakeup = &button6;
	};
	
	buttons {
		compatible = "gpio-keys";

        button6: button_6 {
            label = "Button 6";
            gpios = <&gpio0 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };
	};
};