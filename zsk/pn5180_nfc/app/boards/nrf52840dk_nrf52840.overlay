
&arduino_spi {
	status = "okay";
	pn5180: pn5180@0 {
 		compatible = "nxp,pn5180";
		reg = <0>;
		spi-max-frequency = <7000000>;
		irq-gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
		rst-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		busy-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
		nss-gpios = <&gpio0 28 GPIO_ACTIVE_LOW>;
		timeout-ms = <1000>;
	};
};