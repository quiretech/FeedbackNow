/*
 * Custom overlay for nRF52840-based board
 * Enables I2C0 and UART0 (for shell)
 */

&i2c0 {
    compatible = "nordic,nrf-twi";
    status = "okay";

    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";

    /* PCF8523 Real-Time Clock */
    pcf8523: pcf8523@68 {
        compatible = "nxp,pcf8523";
        reg = <0x68>;
        quartz-load-femtofarads = <7000>;
        battery-switch-over = "standard";
    };
};

/* ---------- PINCTRL configuration ---------- */
&pinctrl {
    uart0_default: uart0_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 23)>,
                    <NRF_PSEL(UART_RTS, 0, 5)>;
        };
        group2 {
            psels = <NRF_PSEL(UART_RX, 0, 20)>,
                    <NRF_PSEL(UART_CTS, 0, 7)>;
            bias-pull-up;
        };
    };

    uart0_sleep: uart0_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 23)>,
                    <NRF_PSEL(UART_RX, 0, 20)>,
                    <NRF_PSEL(UART_RTS, 0, 5)>,
                    <NRF_PSEL(UART_CTS, 0, 7)>;
            low-power-enable;
        };
    };
};

/* ---------- UART configuration ---------- */
&uart0 {
    compatible = "nordic,nrf-uarte";
    status = "okay";
    current-speed = <115200>;

    /* Link pinctrl groups */
    pinctrl-0 = <&uart0_default>;
    pinctrl-1 = <&uart0_sleep>;
    pinctrl-names = "default", "sleep";

    /* Optional: disable HW flow control if not used */
    // hw-flow-control;
};
